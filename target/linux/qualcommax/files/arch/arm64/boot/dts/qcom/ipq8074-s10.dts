/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-ac-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include "ipq8074-nss.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Swaiot CPE-S10-SKY";
	compatible = "swaiot,cpe-s10-sky", "qcom,ipq8074-ap-ac02", "qcom,ipq8074";
	qcom,msm-id = <0x178 0x0>;

	aliases {
		serial0 = &blsp1_uart3;
		ethernet0 = &dp5; /* WAN - 2.5G */
		ethernet1 = &dp3; /* LAN1 - 1G */
		ethernet2 = &dp4; /* LAN2 - 1G */
		led-boot = &led_system_red;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " swiotlb=1 coherent_pool=2M";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>; /* 2GB */
	};

	keys {
		compatible = "gpio-keys";

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* 4G indicators */
		led_4g_yellow: led_4g_yellow {
			label = "yellow:4g";
			gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_4g_blue: led_4g_blue {
			label = "blue:4g";
			gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		/* System indicators */
		led_system_red: led_system_red {
			label = "red:system";
			gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_system_blue: led_system_blue {
			label = "blue:system";
			gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		/* Ethernet indicators */
		led_eth_blue: led_eth_blue {
			label = "blue:ethernet";
			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_eth_yellow: led_eth_yellow {
			label = "yellow:ethernet";
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		/* 5G indicators */
		led_5g_blue: led_5g_blue {
			label = "blue:5g";
			gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_5g_yellow: led_5g_yellow {
			label = "yellow:5g";
			gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* ART分区MAC地址读取 */
	nvmem-layout {
		compatible = "fixed-layout";
		
		/* WiFi校准数据 - 根据原始DTS，偏移0x1000 */
		precal_art_1000: precal@1000 {
			reg = <0x1000 0x2f20>;
		};
		
		/* MAC地址 - 偏移0x1002，共4组MAC地址 */
		macaddr_art_1002: macaddr@1002 {
			reg = <0x1002 0x6>;
			compatible = "mac-base";
			#nvmem-cell-cells = <1>;
		};
		
		macaddr_art_1008: macaddr@1008 {
			reg = <0x1008 0x6>;
			compatible = "mac-base";
			#nvmem-cell-cells = <1>;
		};
		
		macaddr_art_100e: macaddr@100e {
			reg = <0x100e 0x6>;
			compatible = "mac-base";
			#nvmem-cell-cells = <1>;
		};
		
		macaddr_art_1014: macaddr@1014 {
			reg = <0x1014 0x6>;
			compatible = "mac-base";
			#nvmem-cell-cells = <1>;
		};
	};
};

&tlmm {
	button_pins: button_pins {
		reset_button {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		wps_button {
			pins = "gpio50";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led_pins {
		4gyellow {
			pins = "gpio42";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		4gblue {
			pins = "gpio43";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		blue {
			pins = "gpio51";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		red {
			pins = "gpio52";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		ethblue {
			pins = "gpio55";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		ethyellow {
			pins = "gpio56";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		5gblue {
			pins = "gpio63";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		5gyellow {
			pins = "gpio64";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio_pins: mdio_pinmux {
		mux_0 {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		
		mux_1 {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie0_pins: pcie_pins {
		pcie0_rst {
			pins = "gpio58";
			function = "pcie0_rst";
			drive-strength = <8>;
			bias-pull-down;
		};
		
		pcie0_wake {
			pins = "gpio59";
			function = "pcie0_wake";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&blsp1_uart3 {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&crypto {
	status = "okay";
};

&prng {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* 根据原始DTS，根文件系统从0开始，250MB */
			partition@0 {
				label = "ubi";
				reg = <0x00000000 0x0fa00000>; /* 250MB */
			};

			/* ART分区在0xffd0000，256KB */
			partition@ffd0000 {
				label = "art";
				reg = <0x0ffd0000 0x00040000>; /* 256KB */
				read-only;
				
				compatible = "nvmem-cells";
				#address-cells = <1>;
				#size-cells = <1>;
				
				/* 重复定义以供网络接口使用 */
				precal_art_1000: precal@1000 {
					reg = <0x1000 0x2f20>;
				};
				
				macaddr_art_1002: macaddr@1002 {
					reg = <0x1002 0x6>;
				};
			};
		};
	};
};

&qusb_phy_0 {
	status = "okay";
};

&qusb_phy_1 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&ssphy_1 {
	status = "okay";
};

&usb_0 {
	status = "okay";
};

&usb_1 {
	status = "okay";
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qcom,package-mode = "qsgmii";

		/* 1G PHYs for LAN ports */
		qca8075_1: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_2: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		/* 2.5G PHY for WAN port */
		qca8081: ethernet-phy@24 {
			compatible = "ethernet-phy-id004d.d101";
			reg = <24>;
			reset-deassert-us = <10000>;
			reset-gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;

			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					color = <LED_COLOR_ID_GREEN>;
					function = LED_FUNCTION_WAN;
					default-state = "keep";
				};
			};
		};
	};
};

&switch {
	status = "okay";

	switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2)>; /* LAN port bitmap */
	switch_wan_bmp = <ESS_PORT5>; /* WAN port bitmap */
	switch_mac_mode = <MAC_MODE_QSGMII>; /* mac mode for uniphy instance0 */
	switch_mac_mode1 = <MAC_MODE_SGMII_PLUS>; /* mac mode for uniphy instance1 */

	qcom,port_phyinfo {
		port@2 {
			port_id = <3>;
			phy_address = <2>;
		};
		
		port@3 {
			port_id = <4>;
			phy_address = <3>;
		};
		
		port@4 {
			port_id = <5>;
			phy_address = <24>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&edma {
	status = "okay";
};

/* LAN1 - 1G */
&dp3 {
	status = "okay";
	phy-mode = "sgmii";
	phy-handle = <&qca8075_1>;
	label = "lan1";
	nvmem-cells = <&macaddr_art_1002 2>;
	nvmem-cell-names = "mac-address";
};

/* LAN2 - 1G */
&dp4 {
	status = "okay";
	phy-mode = "sgmii";
	phy-handle = <&qca8075_2>;
	label = "lan2";
	nvmem-cells = <&macaddr_art_1002 3>;
	nvmem-cell-names = "mac-address";
};

/* WAN - 2.5G */
&dp5 {
	status = "okay";
	phy-mode = "sgmii";
	phy-handle = <&qca8081>;
	label = "wan";
	nvmem-cells = <&macaddr_art_1002 1>;
	nvmem-cell-names = "mac-address";
};

&pcie_qmp0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	pinctrl-0 = <&pcie0_pins>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 59 GPIO_ACTIVE_LOW>;
};

&pcie1 {
	status = "okay";
	perst-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 62 GPIO_ACTIVE_LOW>;
};

/* WiFi配置 */
&wifi {
	status = "okay";
	
	wifi0: wifi@0 {
		status = "okay";
		qcom,ath11k-calibration-variant = "cpe-s10-sky";
		qcom,ath11k-fw-memory-mode = <1>;
		qcom,board_id = <0x92>;
		nvmem-cells = <&precal_art_1000>, <&macaddr_art_1002 0>;
		nvmem-cell-names = "pre-calibration", "mac-address";
		ieee80211-freq-limit = <2400000 2500000>;
	};
	
	wifi1: wifi@1 {
		status = "okay";
		qcom,ath11k-calibration-variant = "cpe-s10-sky";
		qcom,ath11k-fw-memory-mode = <1>;
		qcom,board_id = <0x292>;
		nvmem-cells = <&precal_art_1000>, <&macaddr_art_1008 0>;
		nvmem-cell-names = "pre-calibration", "mac-address";
		ieee80211-freq-limit = <4900000 5900000>;
	};
};

/* NSS配置 */
&nss0 {
	qcom,low-frequency = <187200000>;
	qcom,mid-frequency = <748800000>;
	qcom,max-frequency = <1497600000>;
};

&nss0 {
	npu-supply = <&dummy_reg>;
	mx-supply = <&dummy_reg>;
};

/* 虚拟调节器 */
&dummy_reg {
	status = "okay";
};
