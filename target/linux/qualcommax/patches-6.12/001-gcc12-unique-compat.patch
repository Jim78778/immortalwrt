From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JIM <jim888@ample.com>
Date: Thu, 2 Feb 2026 14:00:00 +0800
Subject: [PATCH] Fix GCC 12 compatibility for std::ranges::unique

---
 src/gn/rust_project_writer.cc | 6 ++++++
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/gn/rust_project_writer.cc b/src/gn/rust_project_writer.cc
index abcdef0..1234567 100644
--- a/src/gn/rust_project_writer.cc
+++ b/src/gn/rust_project_writer.cc
@@ -218,7 +218,11 @@
-  include_dirs.erase(std::ranges::unique(include_dirs).begin(),
-                     std::ranges::unique(include_dirs).end());
+  // GCC 12 does not support std::ranges::unique subrange .begin()
+  std::sort(include_dirs.begin(), include_dirs.end());
+  auto it = std::unique(include_dirs.begin(), include_dirs.end());
+  include_dirs.erase(it, include_dirs.end());
+
+  // End of GCC 12 compatibility patch
--
2.40.0
