/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-common.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Swaiot CPE-S10-SKY";
	/* 兼容 HK01 U-Boot */
	compatible = "swaiot,cpe-s10-sky",
		     "qcom,ipq8074-hk01",
		     "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart3;
		ethernet0 = &dp5;   /* WAN 2.5G */
		ethernet1 = &dp1;   /* LAN1 */
		ethernet2 = &dp2;   /* LAN2 */
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " swiotlb=1 coherent_pool=2M";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>; /* 2GB */
	};

	/* ===== BUTTONS ===== */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	/* ===== LEDS ===== */
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		sys_blue: blue {
			label = "s10:blue";
			gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
		};

		sys_red: red {
			label = "s10:red";
			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
		};

		/* 4G indicators */
		led_4g_yellow {
			label = "4g:yellow";
			gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		};

		led_4g_blue {
			label = "4g:blue";
			gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
		};

		/* Ethernet indicators */
		led_eth_blue {
			label = "eth:blue";
			gpios = <&tlmm 55 GPIO_ACTIVE_LOW>;
		};

		led_eth_yellow {
			label = "eth:yellow";
			gpios = <&tlmm 56 GPIO_ACTIVE_LOW>;
		};

		/* 5G indicators */
		led_5g_blue {
			label = "5g:blue";
			gpios = <&tlmm 63 GPIO_ACTIVE_LOW>;
		};

		led_5g_yellow {
			label = "5g:yellow";
			gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
		};
	};
};

/* ===== PINMUX ===== */
&tlmm {
	button_pins: button-pins {
		pins = "gpio34", "gpio50";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio42", "gpio43", "gpio51", "gpio52",
		       "gpio55", "gpio56", "gpio63", "gpio64";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio_pins: mdio-pins {
		mux_0 {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_1 {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

/* ===== UART ===== */
&blsp1_uart3 {
	status = "okay";
};

/* ===== SPI NOR (原厂分区，ART在此) ===== */
&blsp1_spi1 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 { label = "0:SBL1"; reg = <0x00000 0x50000>; read-only; };
			partition@50000 { label = "0:MIBIB"; reg = <0x50000 0x10000>; read-only; };
			partition@60000 { label = "0:BOOTCONFIG"; reg = <0x60000 0x20000>; read-only; };
			partition@80000 { label = "0:BOOTCONFIG1"; reg = <0x80000 0x20000>; read-only; };
			partition@a0000 { label = "0:QSEE"; reg = <0xa0000 0x180000>; read-only; };
			partition@220000 { label = "0:QSEE_1"; reg = <0x220000 0x180000>; read-only; };
			partition@3a0000 { label = "0:DEVCFG"; reg = <0x3a0000 0x10000>; read-only; };
			partition@3b0000 { label = "0:DEVCFG_1"; reg = <0x3b0000 0x10000>; read-only; };
			partition@3c0000 { label = "0:APDP"; reg = <0x3c0000 0x10000>; read-only; };
			partition@3d0000 { label = "0:APDP_1"; reg = <0x3d0000 0x10000>; read-only; };
			partition@3e0000 { label = "0:RPM"; reg = <0x3e0000 0x40000>; read-only; };
			partition@420000 { label = "0:RPM_1"; reg = <0x420000 0x40000>; read-only; };
			partition@460000 { label = "0:CDT"; reg = <0x460000 0x10000>; read-only; };
			partition@470000 { label = "0:CDT_1"; reg = <0x470000 0x10000>; read-only; };
			partition@480000 { label = "0:APPSBLENV"; reg = <0x480000 0x10000>; };
			partition@490000 { label = "0:APPSBL"; reg = <0x490000 0xa0000>; read-only; };
			partition@530000 { label = "0:APPSBL_1"; reg = <0x530000 0xa0000>; read-only; };
			
			/* ART 分区 - 256KB (mtd18) - 存放 MAC 地址和校准数据 */
			partition@5d0000 {
				label = "0:ART";
				reg = <0x5d0000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* MAC 地址基址，支持偏移 */
					macaddr_art: macaddr@1002 {
						reg = <0x1002 0x6>;
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
					};

					/* WiFi 校准数据（如果需要） */
					precal_art: precal@1000 {
						reg = <0x1000 0x2f20>;
					};
				};
			};

			partition@610000 { label = "0:ETHPHYFW"; reg = <0x610000 0x80000>; read-only; };
			partition@690000 { label = "ledeinfo"; reg = <0x690000 0x10000>; };
			partition@6a0000 { label = "reserve"; reg = <0x6a0000 0x10000>; };
		};
	};
};

/* ===== QPIC NAND (核心存储 - 仅 UBI) ===== */
&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-bus-width = <8>;
		/* Micron MT29F2G08ABBGAH4 需要 4-bit ECC */
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* UBI 主分区 - 250MB (OpenWrt 标准 rootfs 分区名) */
			partition@0 {
				label = "rootfs";
				reg = <0x00000000 0x0fa00000>;
			};
		};
	};
};

/* ===== USB ===== */
&qusb_phy_0 { status = "okay"; };
&qusb_phy_1 { status = "okay"; };
&ssphy_0 { status = "okay"; };
&ssphy_1 { status = "okay"; };
&usb_0 { status = "okay"; };
&usb_1 { status = "okay"; };

/* ===== MDIO & PHY ===== */
&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;

	phy2: ethernet-phy@2 {
		reg = <2>;
	};

	phy3: ethernet-phy@3 {
		reg = <3>;
	};

	phy4: ethernet-phy@24 {
		reg = <24>;
		compatible = "ethernet-phy-id004d.d101";
	};
};

/* ===== SWITCH ===== */
&switch {
	status = "okay";

	switch_cpu_bmp = <0x1>;
	switch_lan_bmp = <0x18>;   /* port3 + port4 */
	switch_wan_bmp = <0x20>;   /* port5 */
	switch_mac_mode = <MAC_MODE_QSGMII>;
	switch_mac_mode1 = <MAC_MODE_SGMII_PLUS>;

	qcom,port_phyinfo {
		port@3 {
			port_id = <3>;
			phy_address = <2>;
		};
		port@4 {
			port_id = <4>;
			phy_address = <3>;
		};
		port@5 {
			port_id = <5>;
			phy_address = <24>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&edma { status = "okay"; };

/* ===== ETHERNET PORTS (从 ART 读取 MAC 地址) ===== */
&dp1 {
	status = "okay";
	phy-mode = "qsgmii";
	phy-handle = <&phy2>;
	label = "lan1";
	nvmem-cells = <&macaddr_art 2>;  /* LAN1: 基址 + 2 */
	nvmem-cell-names = "mac-address";
};

&dp2 {
	status = "okay";
	phy-mode = "qsgmii";
	phy-handle = <&phy3>;
	label = "lan2";
	nvmem-cells = <&macaddr_art 3>;  /* LAN2: 基址 + 3 */
	nvmem-cell-names = "mac-address";
};

&dp5 {
	status = "okay";
	phy-mode = "usxgmii";   /* 2.5G */
	phy-handle = <&phy4>;
	label = "wan";
	nvmem-cells = <&macaddr_art 1>;  /* WAN: 基址 + 1 */
	nvmem-cell-names = "mac-address";
};

/* ===== WIFI (使用标签安全引用) ===== */
&wifi {
	status = "okay";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "Swaiot-CPE-S10-SKY";
	/* 如果有校准数据，可以添加 */
	/* nvmem-cells = <&precal_art>; */
	/* nvmem-cell-names = "pre-calibration"; */
};

/* ===== PCIe (5G模块) ===== */
&pcie_qmp0 { status = "okay"; };
&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 59 GPIO_ACTIVE_HIGH>;
};
&pcie1 { status = "okay"; };
